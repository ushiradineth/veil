{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "benchmarks/results/**",
    "dist/**",
    "coverage/**",
    "node_modules/**",
    ".agents/**",
    ".claude/**",
    ".veil/**",
    "BENCHMARKS.md",
    "test/fixtures/**",
    "package-lock.json"
  ]
}
