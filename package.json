{
  "name": "@ushiradineth/veil",
  "version": "0.1.3",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/ushiradineth/veil"
  },
  "homepage": "https://github.com/ushiradineth/veil",
  "bugs": {
    "url": "https://github.com/ushiradineth/veil/issues"
  },
  "bin": {
    "veil": "bin/veil.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "mcp": "bun run src/server.ts",
    "server": "bun run src/bin.ts server",
    "cli": "bun run src/bin.ts cli",
    "build:package": "node scripts/build-package.mjs",
    "prepack": "npm run build:package",
    "build": "bun run src/cli.ts build",
    "refresh": "bun run src/cli.ts refresh",
    "status": "bun run src/cli.ts status",
    "test": "bun test ./src/test.ts",
    "bench": "bun run src/bench.ts",
    "bench:harness": "bun run src/bench-harness.ts",
    "bench:baseline": "bun run src/bench-harness.ts --save-baseline",
    "bench:compare": "bun run src/bench-harness.ts --compare",
    "bench:comparison": "bun run src/bench-comparison.ts",
    "bench:suite": "bun run src/bench-suite.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.18.0",
    "@toon-format/toon": "^2.1.0",
    "node-html-markdown": "^2.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "esbuild": "^0.25.1",
    "typescript": "^5.9.0"
